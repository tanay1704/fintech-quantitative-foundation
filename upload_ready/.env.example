# ==============================================================================
# BLUESTOCK FINTECH & QUANTITATIVE FOUNDATION - PIPELINE CONFIGURATION
# ==============================================================================

# REST API Connection & Concurrency Settings
API_REQUEST_TIMEOUT=12
MAX_CONCURRENT_WORKERS=8
MAX_HTTP_RETRIES=3
HTTP_BACKOFF_FACTOR=1.0

# Ingestion Pipeline Target Paths & Logging
OUTPUT_CSV_PATH=api_data_extract.csv
LOG_LEVEL=INFO

# Optional: Public REST Provider / Ingestion Gateway URL Override
# REST_ENDPOINT_TEMPLATE=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}?interval=1d&range=1d
